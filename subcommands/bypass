#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Strip command prefix if dokku passed it
[[ "${1:-}" == sso:* ]] && shift

APP="$1"
PATHS="$2"

if [[ -z "$APP" ]]; then
  echo "Usage: dokku sso:bypass <app> [<path>[,<path>...]|--clear]" >&2
  echo "" >&2
  echo "Exempt path prefixes from the SSO auth check for an app." >&2
  echo "With no paths, lists the current bypasses." >&2
  echo "" >&2
  echo "Bypassed paths are served without any Authelia check, so only list" >&2
  echo "paths the app itself authenticates (API tokens, signed webhook URLs)." >&2
  echo "" >&2
  echo "Example:" >&2
  echo "    dokku sso:bypass homeassistant /api/,/auth/" >&2
  exit 1
fi

if ! "$DOKKU_BIN" apps:exists "$APP" < /dev/null 2>/dev/null; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

# Auto-detect frontend service
FRONTEND_DIR="$PLUGIN_DATA_ROOT/frontend"
SERVICES=()

if [[ -d "$FRONTEND_DIR" ]]; then
  for dir in "$FRONTEND_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    SERVICES+=("$(basename "$dir")")
  done
fi

if [[ ${#SERVICES[@]} -eq 0 ]]; then
  echo "!     No frontend service found" >&2
  echo "       Create one with: dokku sso:frontend:create <name>" >&2
  exit 1
fi

if [[ ${#SERVICES[@]} -gt 1 ]]; then
  echo "!     Multiple frontend services found: ${SERVICES[*]}" >&2
  echo "       Bypass paths are per-app; remove the extra frontend or edit" >&2
  echo "       $FRONTEND_DIR/<service>/bypass/$APP directly." >&2
  exit 1
fi

SERVICE="${SERVICES[0]}"
SERVICE_ROOT="$PLUGIN_DATA_ROOT/frontend/$SERVICE"
BYPASS_DIR="$SERVICE_ROOT/bypass"
BYPASS_FILE="$BYPASS_DIR/$APP"

# List mode
if [[ -z "$PATHS" ]]; then
  echo "=====> Bypass paths for $APP ($SERVICE)"
  if [[ -s "$BYPASS_FILE" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] && echo "       $p"
    done < "$BYPASS_FILE"
  else
    echo "       (none)"
  fi
  exit 0
fi

mkdir -p "$BYPASS_DIR"

if [[ "$PATHS" == "--clear" ]]; then
  rm -f "$BYPASS_FILE"
  echo "-----> Cleared bypass paths for $APP"
else
  # Every path must be absolute — nginx location prefixes start with /, and a
  # bare word would silently match nothing. Validate before writing anything,
  # so a rejected argument cannot leave a stray temp file behind.
  NORMALIZED="$(echo "$PATHS" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d')"
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    if [[ "$p" != /* ]]; then
      echo "!     Bypass path must start with /: $p" >&2
      exit 1
    fi
  done <<<"$NORMALIZED"

  if [[ -n "$NORMALIZED" ]]; then
    printf '%s\n' "$NORMALIZED" >"$BYPASS_FILE"
  else
    : >"$BYPASS_FILE"
  fi

  echo "-----> Bypass paths for $APP:"
  while IFS= read -r p; do
    echo "       $p"
  done < "$BYPASS_FILE"
fi

# Only regenerate if the app is currently protected; otherwise the stored
# paths just wait for the next protect.
if [[ -f "$SERVICE_ROOT/PROTECTED" ]] && grep -qx "$APP" "$SERVICE_ROOT/PROTECTED"; then
  echo "-----> Regenerating nginx config for $APP"
  load_frontend_provider "$SERVICE"
  provider_protect_app "$SERVICE" "$APP"
  "$DOKKU_BIN" proxy:build-config "$APP" < /dev/null
  echo "-----> Applied"
else
  echo "       $APP is not protected; paths saved for when it is"
fi
